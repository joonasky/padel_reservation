{
  "name": "padel-reservation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate": "npx dotenv run -f .env.local -- npx prisma generate",
    "postinstall": "prisma generate",
    "migrate": "npx dotenv run -f .env.local -- npx prisma migrate dev",
    "dev": "npx dotenv run -f .env.local -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test:setup": "docker-compose -f docker-compose.tests.yml up -d && sleep 3 && dotenv run -f .env.test -- npx prisma migrate deploy",
    "test:e2e": "dotenv run -f .env.test -- playwright test ./tests/e2e/",
    "test:teardown": "docker-compose -f docker-compose.tests.yml down",
    "test:unit": "dotenv run -f .env.test -- jest"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/types": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "babel-jest": "^30.5.1",
    "babel-plugin-superjson-next": "^0.4.5",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.0",
    "identity-obj-proxy": "^3.0.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-fetch-mock": "^4.2.0",
    "next-router-mock": "^1.0.5",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
